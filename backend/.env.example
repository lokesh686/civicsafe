# Database (use Neon, Supabase, Railway, or local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname?sslmode=require

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
HASHING_SCHEME=bcrypt

# API Configuration (production URL)
API_URL=https://your-backend-domain.com

# Analytics export
ANALYTICS_EXCEL_PATH=analytics/analytics.xlsx

# Google Sheets/Drive (optional)
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
